{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juno (Tauri 2): select anything on screen and ask Claude or ChatGPT about it.",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "app": "node scripts/app.mjs",
    "web:dev": "vite",
    "web:build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/icons.mjs && tauri icon src-tauri/icons/app.png -o src-tauri/icons",
    "tauri": "tauri",
    "build:e2e": "SAI_E2E=1 vite build && CARGO_TARGET_DIR=src-tauri/target/e2e cargo build --manifest-path src-tauri/Cargo.toml --features test-hook,custom-protocol",
    "test:e2e": "pnpm build:e2e && vitest run --config vitest.e2e.config.ts",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "marked": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
