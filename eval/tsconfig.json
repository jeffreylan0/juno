{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "@/*": ["../desktop/src/*"]
    }
  },
  // Only the app modules the eval scripts actually run. The rest of
  // desktop/src/lib touches browser globals that do not exist in Node.
  "include": [
    "*.ts",
    "../shared/*.ts",
    "../desktop/src/lib/cache.ts",
    "../desktop/src/lib/router.ts",
    "../desktop/src/lib/providers/**/*.ts"
  ]
}
