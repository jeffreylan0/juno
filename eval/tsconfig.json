{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@shared/*": ["../shared/*"],
      "@/*": ["../extension/*"],
      "#imports": ["./shims/imports.ts"]
    }
  },
  // Only the extension modules the eval scripts actually run. The rest of
  // extension/lib touches browser globals that do not exist in Node.
  "include": [
    "*.ts",
    "shims/*.ts",
    "../shared/*.ts",
    "../extension/lib/cache.ts",
    "../extension/lib/router.ts",
    "../extension/lib/providers/**/*.ts"
  ]
}
