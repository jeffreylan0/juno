{
  "name": "selection-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Juno: a desktop app to draw a box or any shape around something on screen and ask Claude or ChatGPT about exactly that.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "app": "pnpm --filter desktop app",
    "build": "pnpm --filter desktop build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "vitest": "vitest",
    "test:native": "pnpm --filter desktop test:native",
    "test:e2e": "pnpm --filter desktop test:e2e",
    "eval:run": "pnpm --filter eval exec tsx run.ts",
    "eval:batch": "pnpm --filter eval exec tsx batch.ts",
    "eval:score": "pnpm --filter eval exec tsx score.ts",
    "eval:crops": "pnpm --filter eval exec tsx crops.ts",
    "worker:dev": "pnpm --filter worker dev"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@webext-core/fake-browser": "^2.0.1",
    "@wxt-dev/storage": "1.3.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.4"
  }
}
