# Copy to .env.local (gitignored). Development keys only; production keys live as Worker secrets.

# Which provider the eval scripts use: mock | local | byok (the app asks at first run)
PROVIDER=mock

# Eval-script keys (never built into the app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model server (Ollama, OpenAI-compatible)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5vl:7b

# WXT_* lines are read by the app's build (desktop/vite.config.ts).

# Accounts (optional; see supabase/README.md). Without both, the build has no accounts.
WXT_SUPABASE_URL=
WXT_SUPABASE_KEY=

# Hosted answers: the deployed Worker (see supabase/README.md, step 8)
WXT_GATEWAY_URL=http://localhost:8787
